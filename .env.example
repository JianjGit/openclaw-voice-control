OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_WS_URL=
OPENCLAW_TOKEN=replace_me
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_KEY=agent:main:main
OPENCLAW_HOME=~/.openclaw
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_WS_TIMEOUT=30

# Optional mirror delivery. Off by default.
# OPENCLAW_SESSION_KEY still controls only the answering conversation.
# OPENCLAW_DELIVERY_TARGET must name an entry already declared in delivery_targets.
OPENCLAW_DELIVERY_MODE=off
OPENCLAW_DELIVERY_TARGET=
# Privacy-sensitive: when true, recognized user speech is sent externally before
# chat.send, then the final assistant reply is mirrored as usual.
OPENCLAW_DELIVERY_INCLUDE_USER_TRANSCRIPT=false

# Optional overrides for a predeclared YAML target. These do not create new targets.
# OPENCLAW_DELIVERY_TARGET_FEISHU_JIE_CHANNEL=feishu
# OPENCLAW_DELIVERY_TARGET_FEISHU_JIE_ACCOUNT_ID=default
# OPENCLAW_DELIVERY_TARGET_FEISHU_JIE_TO=user:ou_84727a25ab32163de1ebd612aca75627
# OPENCLAW_DELIVERY_TARGET_DISCORD_HOME_CHANNEL=discord
# OPENCLAW_DELIVERY_TARGET_DISCORD_HOME_ACCOUNT_ID=default
# OPENCLAW_DELIVERY_TARGET_DISCORD_HOME_TO=channel:123456789012345678

STT_HOST=127.0.0.1
STT_PORT=15900

WAKEWORD_PROVIDER=openwakeword
OPENWAKEWORD_MODEL_NAME=hey jarvis
OPENWAKEWORD_MODEL_PATH=
OPENWAKEWORD_THRESHOLD=0.35
WAKEWORD_REARM_SECONDS_AFTER_TURN=0.0

# Optional Porcupine route
PICOVOICE_ACCESS_KEY=
WAKEWORD_FILE=assets/wakeword/your-model.ppn

VOICE_CONTROL_CONFIG=config/default.yaml
SENSEVOICE_MODEL_PATH=models/SenseVoiceSmall
SENSEVOICE_VAD_MODEL_PATH=models/fsmn-vad
